# Copiar a .env para desarrollo local. NUNCA versionar .env real.
# PostgreSQL local (docker compose -p soec, puerto 5544 aislado de otros proyectos).
DATABASE_URL=postgres://soec:soec@localhost:5544/soec
PORT=3000

# ── Seguridad (Macrobloque 1) ────────────────────────────────────────────────────────────────
# Autenticación obligatoria. Default true; en producción DEBE ser true (el arranque falla si no).
SOEC_AUTH_REQUIRED=true
# Acceso DEMO LEGACY: re-registra las rutas /experience/* SIN autenticación. Default false.
# PROHIBIDO en producción (el arranque falla si se habilita). Solo test/dev/demo controlada.
# La ausencia de sesión NUNCA es autorización; este flag no la crea, solo re-expone la demo.
SOEC_LEGACY_DEMO_ACCESS_ENABLED=false
# Entorno: 'production' fuerza auth y prohíbe la demo legacy.
# NODE_ENV=production

# Protección CSRF (F-01): orígenes permitidos para operaciones mutativas (POST/PUT/PATCH/DELETE).
# Lista separada por comas. En PRODUCCIÓN es OBLIGATORIA (el arranque falla si está vacía).
# En dev, si se omite, se asume el front local (http://localhost:3080, http://localhost:3000).
SOEC_ALLOWED_ORIGINS=http://localhost:3080,http://localhost:3000

# Rate limiting de autenticación (F-06). En-memoria POR PROCESO (multi-instancia requerirá Redis).
# login por (email,IP); ipMax es el agregado por IP (frena password spraying); reset por IP.
SOEC_RL_LOGIN_MAX=5
SOEC_RL_IP_MAX=30
SOEC_RL_RESET_MAX=5
SOEC_RL_WINDOW_MIN=15

# ── Bootstrap idempotente del owner/organización inicial (opcional) ───────────────────────────
# Solo se ejecuta si SOEC_BOOTSTRAP_ENABLED=true. NUNCA commitear credenciales reales.
SOEC_BOOTSTRAP_ENABLED=false
SOEC_BOOTSTRAP_OWNER_EMAIL=
SOEC_BOOTSTRAP_OWNER_PASSWORD=
SOEC_BOOTSTRAP_OWNER_NAME=Owner
SOEC_BOOTSTRAP_ORG_SLUG=smileflow
SOEC_BOOTSTRAP_ORG_NAME=SmileFlow
