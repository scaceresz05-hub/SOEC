{
  "name": "soec",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:pg": "vitest run --config vitest.pg.config.ts",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "db:up": "docker compose -p soec -f infrastructure/docker-compose.yml up -d",
    "db:down": "docker compose -p soec -f infrastructure/docker-compose.yml down -v",
    "migrate": "tsx packages/decision/src/pg/migrate-cli.ts",
    "emulador": "tsx packages/canal-emulado/src/server.ts",
    "start-local": "node scripts/start-local.mjs",
    "sprint0:preflight": "tsx apps/api/scripts/preflight.ts",
    "piloto:check": "tsx apps/api/scripts/preflight.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
